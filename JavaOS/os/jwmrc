<?xml version="1.0"?>
<!-- Оконный менеджер JavaOS: рамки для окон Linux-программ. JavaWin — рабочий стол под ними. -->
<JWM>
    <!-- сам JavaWin — окно без оконного менеджера (override-redirect), JWM его не видит -->

    <!-- панель окон Linux-программ: прячется у верхнего края, всплывает при наведении -->
    <Tray x="0" y="0" height="30" autohide="top" layer="above">
        <TaskList maxwidth="240"/>
    </Tray>

    <WindowStyle decorations="flat">
        <Font>DejaVu Sans-10</Font>
        <Width>3</Width>
        <Height>28</Height>
        <Corner>4</Corner>
        <Foreground>#d0d0d0</Foreground>
        <Background>#2b2b2b</Background>
        <Outline>#3c3c3c</Outline>
        <Opacity>1.0</Opacity>
        <Active>
            <Foreground>#ffffff</Foreground>
            <Background>#1f3b66</Background>
            <Outline>#3b82f6</Outline>
            <Opacity>1.0</Opacity>
        </Active>
    </WindowStyle>
    <TrayStyle decorations="flat">
        <Font>DejaVu Sans-10</Font>
        <Background>#202020</Background>
        <Foreground>#ffffff</Foreground>
        <Opacity>0.95</Opacity>
    </TrayStyle>
    <TaskListStyle list="all" group="false">
        <Font>DejaVu Sans-10</Font>
        <Active>
            <Foreground>#ffffff</Foreground>
            <Background>#3b82f6</Background>
        </Active>
        <Foreground>#d0d0d0</Foreground>
        <Background>#2b2b2b</Background>
    </TaskListStyle>
    <MenuStyle decorations="flat">
        <Font>DejaVu Sans-10</Font>
        <Foreground>#ffffff</Foreground>
        <Background>#2b2b2b</Background>
        <Active>
            <Foreground>#ffffff</Foreground>
            <Background>#3b82f6</Background>
        </Active>
    </MenuStyle>

    <Desktops width="1" height="1"/>
    <FocusModel>click</FocusModel>
    <SnapMode distance="10">border</SnapMode>
    <MoveMode>opaque</MoveMode>
    <ResizeMode>opaque</ResizeMode>
    <DoubleClickSpeed>400</DoubleClickSpeed>

    <!-- горячих клавиш нет: Alt+F4 и прочие обрабатывает JavaWin, иначе JWM закрыл бы сам рабочий стол -->
</JWM>
